
import torch
from pathlib import Path
from diffusers import StableDiffusionPipeline

ROOT = Path(__file__).resolve().parents[1]
OUTPUT_DIR = ROOT / "storage" / "generated"

MODEL_ID = "stable-diffusion-v1-5/stable-diffusion-v1-5"

def main():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    if not torch.backends.mps.is_available():
        print("Apple MPS is not available.")
        return

    device = "mps"

    print("Loading Bharat AI image generation model...")
    print("First run will download model weights.")

    pipe = StableDiffusionPipeline.from_pretrained(
        MODEL_ID,
        torch_dtype=torch.float16,
        use_safetensors=True
    )

    pipe = pipe.to(device)
    pipe.enable_attention_slicing()

    prompt = (
        "A beautiful traditional Indian temple, "
        "intricate stone carvings, golden hour sunlight, "
        "high detail, photorealistic photography"
    )

    print("Generating image...")

    with torch.inference_mode():
        image = pipe(
            prompt=prompt,
            height=512,
            width=512,
            num_inference_steps=20,
            guidance_scale=7.0
        ).images[0]

    output_path = OUTPUT_DIR / "bharat_ai_first_image.png"
    image.save(output_path)

    print("Image generated successfully!")
    print("Saved at:", output_path)

if __name__ == "__main__":
    main()

